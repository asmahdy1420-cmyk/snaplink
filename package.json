{
	"name": "snaplink",
	"version": "0.1.0",
	"description": "Self-hosted URL shortener with privacy-friendly click analytics, built with SvelteKit and SQLite.",
	"private": true,
	"type": "module",
	"author": "Ahmed Mahdy",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/asmahdy1420-cmyk/snaplink.git"
	},
	"homepage": "https://github.com/asmahdy1420-cmyk/snaplink#readme",
	"bugs": {
		"url": "https://github.com/asmahdy1420-cmyk/snaplink/issues"
	},
	"keywords": [
		"url-shortener",
		"sveltekit",
		"svelte",
		"sqlite",
		"analytics",
		"self-hosted",
		"qr-code"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test:unit": "vitest",
		"test": "vitest --run"
	},
	"dependencies": {
		"better-sqlite3": "^13.0.3",
		"qrcode": "^1.5.4",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^24",
		"@types/qrcode": "^1.5.6",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	}
}
