# Secret used to sign in to /admin. Admin access is disabled when empty.
ADMIN_TOKEN=change-me-to-a-long-random-string
# SQLite database file. The directory is created on start-up.
DATABASE_PATH=./data/snaplink.db
# Public origin of the deployment, used by the Node adapter (required behind a proxy or in production).
ORIGIN=http://localhost:3000
# Set to "false" to allow only the signed-in admin to create links.
PUBLIC_CREATION=true
